# =============================================================================
# Smart Sales Meeting Intelligence (SSMI) — Environment Template (.env.example)
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql+asyncpg://ssmi_user:ssmi_password@localhost:5432/ssmi_db

# Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword

# AI Pipeline & Quantized LLM Configuration
VLLM_ENDPOINT=http://localhost:11434/v1
VLLM_MODEL_NAME=qwen2.5:14b
WHISPER_MODEL_NAME=large-v3-turbo
WHISPER_FAST_MODEL=small
WHISPER_CPU_MODEL=base
WHISPER_CPU_THREADS=1
USE_CUDA=false
HUGGINGFACE_TOKEN=hf_your_token_here

# Server & API Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key

# Frontend Connection URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

{
  "name": "ssmi-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "dev:backend": "cd .. && .venv\\Scripts\\python.exe -m uvicorn services.api.fastapi.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:all": "concurrently --names \"NEXT,API\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run dev:backend\"",
    "build": "cd apps/web && npm install && npm run build",
    "start": "cd apps/web && npm run start"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  }
}
